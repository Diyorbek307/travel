# Пароль админ-панели. Без него используется "admin" — годится только
# для локальной разработки, но не для развёрнутого стенда.
ADMIN_PASSWORD=

# Секрет для подписи сессионной cookie админки.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Каталог изменяемых данных: база SQLite и загруженные аудиогиды.
# По умолчанию — ./data в проекте. На хостинге сюда монтируется постоянный
# диск, иначе всё пропадает при перезапуске контейнера.
DATA_DIR=

# Адрес платформы — подставляется в QR-коды при печати табличек.
# На Render заполняется автоматически из RENDER_EXTERNAL_URL; своя переменная
# нужна только при подключении собственного домена.
APP_BASE_URL=

# ── Маршруты по дорогам ──────────────────────────────────────────────
# Без этого приложение рисует прямую линию между точками и честно
# подписывает её как прямую. С этим — настоящий маршрут по улицам с
# расстоянием и временем в пути.
#
# Вариант первый, быстрый: свободный ключ OpenRouteService.
# Регистрация на openrouteservice.org/dev, ключ вставить сюда.
# Потолок бесплатного тарифа — 2000 маршрутов в сутки.
ORS_API_KEY=

# Вариант второй, без потолка: свой сервер OSRM или Valhalla на данных
# OpenStreetMap по Узбекистану. Указать адрес вида http://маршрутизатор:5000
# Если заполнено, используется он, а ключ выше не трогается.
OSRM_URL=

# Пеший маршрут у OSRM считает отдельный сервер: способ передвижения зашит
# в данные при сборке, и один сервер умеет что-то одно. Пока это поле
# пустое, приложение предлагает только маршрут на машине — предлагать
# «пешком» и показывать при этом автомобильное время нельзя.
OSRM_FOOT_URL=

# ── Где хранятся данные ──────────────────────────────────────────────
# Аккаунты, заявки, отзывы, переписка с поддержкой и правки из админки.
#
# Без этой строки всё пишется в файлы внутри контейнера. На бесплатном
# тарифе Render у контейнера нет постоянного диска: при каждом выкате и
# перезапуске он собирается заново и пустым, поэтому аккаунты приходилось
# заводить снова. Никакой настройкой файлов это не лечится — данные
# должны жить снаружи контейнера.
#
# Строка подключения к Postgres. Бесплатную базу без срока годности дают
# neon.com; подойдёт и Postgres от самого Render.
# Вид: postgresql://пользователь:пароль@хост/база?sslmode=require
DATABASE_URL=

# ── Карта Google ─────────────────────────────────────────────────────
# Без ключа приложение показывает карту OpenStreetMap: улицы там тоже
# настоящие, ключ и платёжная карта не нужны. С ключом экран маршрута
# переходит на карту Google с её собственным маршрутом.
#
# Ключ берётся в console.cloud.google.com, там же надо включить
# «Maps Embed API». Google выдаёт ключи только при привязанном платёжном
# аккаунте, даже когда сам Embed API денег не стоит.
#
# Ключ открытый и уходит в браузер — так устроен Embed API. Обязательно
# ограничьте его своим доменом в консоли Google, иначе им воспользуются
# посторонние.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Оплата: Payme и Click ────────────────────────────────────────────
# Вставьте идентификатор — и кнопка «Оплатить» откроет страницу оплаты.
# Реквизиты карты вводятся только там, приложение их не касается.
#
# Payme: идентификатор кассы (Merchant ID) из кабинета business.payme.uz.
PAYME_MERCHANT_ID=
# Секретный ключ кассы — Payme по нему подтверждает оплату (нужен для eSIM).
# В кабинете Payme адрес для запросов: https://<сайт>/api/payme, поле счёта — order.
PAYME_KEY=
#
# Click: идентификатор продавца и услуги из кабинета Click Merchant.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
# Секретный ключ — Click по нему подтверждает оплату (нужен для eSIM).
# В кабинете Click: Prepare https://<сайт>/api/click/prepare,
# Complete https://<сайт>/api/click/complete.
CLICK_SECRET=

# ── eSIM: Airalo Partner API ─────────────────────────────────────────
# Ключи из партнёрского кабинета Airalo. Магазин eSIM в «Полезном → Связь»
# включится сам, когда есть эти ключи и Payme или Click с секретным ключом.
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=
# Песочница Airalo для проверки без денег (пусто — боевой адрес).
AIRALO_API_URL=
# Сбор за нашу услугу поверх цены Airalo, % (по умолчанию 10; 0 — ровно как у Airalo).
ESIM_MARKUP_PERCENT=
# Курс сума вручную, если не нужен автоматический (пусто — по курсу дня).
ESIM_USD_UZS=
