# Изменяемые данные: база и загруженные медиафайлы.
# База восстанавливается из scripts/content командой npm run seed.
# Ведущий слэш обязателен: без него правило закрывает любую папку data,
# в том числе src/data с исходными данными приложения.
/data/

# Скачанные плитки высот: черновик сборщика рельефа.
# Результат лежит в public/relief, а исходники весят мегабайты.
.relief-cache/

.env
.env*.local

# Локальные скиллы и настройки инструментов разработки.
# Это окружение разработчика, а не часть платформы: у другого участника
# набор инструментов свой, и в репозитории проекта им не место.
.claude/
.agents/
.codex/
.mcp.json
tools/
